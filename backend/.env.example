# ─────────────────────────────────────────────────────────────────────────────
# learning++ environment config
#
# 1. Copy this file to  backend/.env    (same folder — the app reads backend/.env)
#       cp backend/.env.example backend/.env
# 2. Paste your GEMINI_API_KEY (and optional YOUTUBE_API_KEY).
# 3. Restart the server — keys are read only at startup.
#
# ⚠️  Never commit your real backend/.env — it holds secret keys (it's gitignored).
# ⚠️  The real file MUST live at  backend/.env  (NOT the repo root), or the app
#     won't read it and will silently fall back to offline mock mode.
# ─────────────────────────────────────────────────────────────────────────────

# --- Gemini (the lesson engine's AI) ---
# When set (and USE_MOCK_INTEGRATIONS=0), the lesson engine uses the real Gemini
# REST API over urllib: structured JSON for decompose, warm free-text for the
# Coach tutor + per-stage feedback. When empty OR mock is on, everything falls
# back to deterministic offline mocks so the app runs with no key/network.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Lighter fallback models tried automatically on overload (503) / rate-limit (429).
GEMINI_FALLBACKS=gemini-3.1-flash-lite,gemini-3.1-flash

# Optional: real YouTube search for in-flow videos (keyless fallback otherwise).
YOUTUBE_API_KEY=

# --- Mock vs real -----------------------------------------------------------
# 0 = use real integrations (requires GEMINI_API_KEY above).
# 1 = force offline mock mode (safe for demos; no network, no keys needed).
# NOTE: mock also turns on automatically whenever GEMINI_API_KEY is empty.
USE_MOCK_INTEGRATIONS=0

# --- Lesson engine tuning (all optional; sensible defaults) ---
TUTOR_TEMPERATURE=0.9
XP_INTRO=5
XP_VIDEO=10
XP_READING=10
XP_CHALLENGE=15
XP_DRAFT=25
XP_COMPLETE=20
DAILY_XP_GOAL=50
# Planner fallback daily cap (minutes) if a user hasn't set their own 1-6h budget.
DAILY_CAP_MIN=120
SUBMISSION_BUFFER_DAYS=1

# --- Security ---
# Generate a strong random value in production, e.g. `openssl rand -hex 32`.
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Database ---
DB_PATH=backend/learnpp.db

# --- Server ---
HOST=127.0.0.1
PORT=8000
