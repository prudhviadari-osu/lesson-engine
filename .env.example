# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Gemini API key — free from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model to use for decomposition. Swap here if Google rotates models.
GEMINI_MODEL=gemini-3.8-flash

# Fallback models tried automatically if the primary is overloaded (503) or
# rate-limited (429). Comma-separated, lightest-first recommended.
GEMINI_FALLBACKS=gemini-3.1-flash-lite,gemini-3.1-flash

# YouTube Data API v3 key — from Google Cloud Console (DIFFERENT from the Gemini
# key). Enable "YouTube Data API v3", then create an API key. Optional: without
# it, video blocks degrade to a YouTube search link instead of a picked video.
YOUTUBE_API_KEY=

# Server port (optional)
PORT=3000
