# Copy to backend/.env and fill in real values on the Ubuntu VM.

# --- Gemini (the lesson engine's AI) ---
# When set, the interactive lesson engine uses the real Gemini REST API over
# urllib (no third-party deps): structured JSON for decompose, warm free-text
# for the Coach tutor + per-stage feedback. When empty, EVERYTHING falls back
# to deterministic offline mocks so the whole app runs with no key/network.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# Lighter fallback models tried automatically on overload (503) / rate-limit (429).
GEMINI_FALLBACKS=gemini-1.5-flash-8b,gemini-1.5-flash

# --- Lesson engine tuning (all optional; sensible defaults) ---
# Warm temperature for the conversational Coach turns + feedback.
TUTOR_TEMPERATURE=0.9
# XP awarded per completed stage of the gamified flow.
XP_INTRO=5
XP_VIDEO=10
XP_READING=10
XP_CHALLENGE=15
XP_DRAFT=25
XP_COMPLETE=20
# Daily XP goal that powers the daily-goal meter.
DAILY_XP_GOAL=50
# Planner: minutes of lessons per day, and days of submission buffer before due.
DAILY_CAP_MIN=15
SUBMISSION_BUFFER_DAYS=1
# Optional: real YouTube search for in-flow videos (keyless fallback otherwise).
YOUTUBE_API_KEY=

# --- Integrations ---
# Set to 0 on the VM to use the real Canvas/OSU/Gemini integrations.
# Leave unset/1 for offline mock mode.
USE_MOCK_INTEGRATIONS=1

# --- Security ---
# Generate a strong random value in production, e.g. `openssl rand -hex 32`.
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Database ---
# SQLite (default, local/dev):
DB_PATH=backend/learnpp.db
# MySQL (production) — see docs/MIGRATION.md for the driver swap:
# DATABASE_URL=mysql+pymysql://user:pass@localhost:3306/learnpp

# --- Server ---
HOST=127.0.0.1
PORT=8000
