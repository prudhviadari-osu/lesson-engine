# ─────────────────────────────────────────────────────────────────────────────
# learning++ environment config
#
# 1. Copy this file to ".env"   →   cp .env.example .env
# 2. Fill in GEMINI_API_KEY (required) and YOUTUBE_API_KEY (optional).
# 3. Restart the server after any change (keys are read at startup).
#
# ⚠️  NEVER commit your real .env — it holds secret keys. It is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED. Gemini API key — free from https://aistudio.google.com/apikey
# Powers: assignment decompose, the "Coach" tutor, and per-stage feedback.
GEMINI_API_KEY=

# Model used for AI calls. If Google retires a model you'll get a
# "model not supported" error — just change this to a current one.
GEMINI_MODEL=gemini-3.8-flash

# Models tried automatically if the primary is overloaded (503) or rate-limited
# (429) — the free tier does this under load. Comma-separated, lightest first.
GEMINI_FALLBACKS=gemini-3.1-flash-lite,gemini-3.1-flash

# OPTIONAL. YouTube Data API v3 key — from Google Cloud Console (a DIFFERENT key
# from Gemini). Enable "YouTube Data API v3" then create an API key. Without it,
# video stages degrade to a YouTube search link instead of an auto-picked video.
YOUTUBE_API_KEY=

# ── Optional tuning dials (sensible defaults; you rarely need to change these) ──

# Server port.
PORT=3000

# Tutor / feedback warmth (0=robotic, 1=lively). 0.9 is a good blend.
TUTOR_TEMPERATURE=0.9

# Gamification: XP per stage + the daily XP goal.
XP_INTRO=5
XP_VIDEO=10
XP_READING=10
XP_CHALLENGE=15
XP_DRAFT=25
XP_COMPLETE=20
DAILY_XP_GOAL=50

# Planner: minutes/day cap and how many empty "buffer" days to leave before a
# due date (so there's always slack to actually submit).
DAILY_CAP_MIN=15
SUBMISSION_BUFFER_DAYS=1

# Where the SQLite DB file lives (defaults to ./learning.db).
# DB_PATH=./learning.db
